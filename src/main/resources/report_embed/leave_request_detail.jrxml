<jasperReport name="leave_request_detail" language="java" columnCount="1" pageWidth="555" pageHeight="842" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="c7dac00a-d4d1-45a9-b6d7-228469a61cec">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hr"/>
	<parameter name="emp_leave_id" class="java.lang.Long"/>
	<query language="SQL"><![CDATA[SELECT
	emp_leave_detail.emp_leave_detail_id, 
	emp_leave_detail.emp_leave_id, 
	list_leave_type.leav_type_code, 
	list_leave_type.leave_name_en, 
	list_leave_type.leave_name_local, 
	emp_leave_detail.from_date, 
	emp_leave_detail.to_date, 
	list_leave_type_sub_type.leave_sub_type_name_en, 
	list_leave_type_sub_type.leave_sub_type_name_kh, 
	emp_leave_detail.leave_duration, 
  emp_leave_detail.number_of_day, 
	emp_leave_detail.remark
FROM
	public.emp_leave_detail
  INNER JOIN	public.list_leave_type	ON 		list_leave_type.leave_type_id = emp_leave_detail.leave_type_id
	INNER JOIN	public.list_leave_type_group	ON 		list_leave_type_group.list_leave_type_group_id = list_leave_type.list_leave_type_group_id
	LEFT JOIN	public.list_leave_type_sub_type	ON 		list_leave_type_sub_type.list_leave_type_sub_type_id = emp_leave_detail.leave_type_sub_type_id
	WHERE emp_leave_detail.emp_leave_id=   $P{emp_leave_id} 

ORDER BY 	emp_leave_detail.from_date, 
	emp_leave_detail.to_date  ]]></query>
