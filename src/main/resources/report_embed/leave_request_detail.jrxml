	<variable name="leave_type_display" class="java.lang.String">
		<expression><![CDATA[( $F{leave_name_en} == null || $F{leave_name_en}.trim().isEmpty() ) &&
        ( $F{leave_name_local} == null || $F{leave_name_local}.trim().isEmpty() )
          ? ""
          : (
              ($F{leave_name_en} == null || $F{leave_name_en}.trim().isEmpty())
                ? $F{leave_name_local}
                : (
                    ($F{leave_name_local} == null || $F{leave_name_local}.trim().isEmpty())
                      ? $F{leave_name_en}
                      : ($F{leave_name_en}.trim() +  " (" + $F{leave_name_local}.trim() + ")")
                  )
            )]]></expression>
	</variable>
	<variable name="leave_subtype_display" class="java.lang.String">
		<expression><![CDATA[ ( $F{leave_sub_type_name_en} == null || $F{leave_sub_type_name_en}.trim().isEmpty() ) &&
