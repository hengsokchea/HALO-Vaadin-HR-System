<jasperReport name="performance review" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="880ba763-8ad5-4f35-ba90-c35732ff6fba">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hr"/>
	<parameter name="emp_performance_review_id" class="java.util.Collection"/>
	<parameter name="SUBREPORT_DIR" forPrompting="false" class="java.lang.String"/>
	<parameter name="ATTACHMENT_DIR" forPrompting="false" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT review.emp_performance_review_id,
	emp_master.insurance_no,
	emp_master.name_en,
	emp_master.name_kh,
	emp_master.gender,
	emp_master.date_of_birth,
	list_position.emp_position,
	list_position.emp_position_kh,
	line_manager.insurance_no AS supervisor_insurance,
	line_manager.name_en AS supervisor_name_en,
	line_manager.name_kh AS supervisor_name_kh,
	review.review_date,
	review.manager_review_date AS supervisor_review_date,
	performance_status.status_name AS supervisor_status,
	review.manager_comments AS supervisor_comments,
	final_review.insurance_no AS final_review_insurance,
	final_review.name_en AS final_review_name_en,
	final_review.name_kh AS final_review_name_kh,
	review.final_review_date,
	final_status.status_name AS final_review_status,
	review.final_review_comments,
	overall_rating
FROM emp_performance_review review
	INNER JOIN emp_master ON 
	 emp_master.emp_id = review.emp_id 
	INNER JOIN list_position ON 
	 list_position.position_id = review.emp_position_id 
	INNER JOIN emp_master line_manager ON 
	 line_manager.emp_id = review.supervisor_emp_id 
	INNER JOIN performance_status ON 
	 performance_status.performance_status_id = review.manager_status_id 
	INNER JOIN emp_master final_review ON 
	 final_review.emp_id = review.final_review_emp_id 
	INNER JOIN performance_status final_status ON 
	 final_status.performance_status_id = review.final_review_status_id  
WHERE 
   $X{IN, review.emp_performance_review_id, emp_performance_review_id}
]]></query>
