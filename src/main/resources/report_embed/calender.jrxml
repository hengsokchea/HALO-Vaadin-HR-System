	<lastPageFooter height="26" splitType="Stretch">
		<element kind="textField" uuid="3b7b0a3c-6c91-4c9f-9c5d-123456789abc" x="50" y="0" width="1050" height="26" fontSize="11.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA[
            new StringBuilder()
                .append(
                    $V{totalWorkingDays} != null && $V{totalWorkingDays} > 0
                    ? "Working Days: " + $V{totalWorkingDays}
                    : ""
                )
                .append(
                    $V{totalPublicHolidays} != null && $V{totalPublicHolidays} > 0
                    ? "   | Public Holidays: " + $V{totalPublicHolidays}
                    : ""
                )
                .append(
                    $V{totalHolidaysInLieu} != null && $V{totalHolidaysInLieu} > 0
                    ? "   | Holidays In Lieu: " + $V{totalHolidaysInLieu}
                    : ""
                )
                .append(
                    $V{totalOffDays} != null && $V{totalOffDays} > 0
                    ? "   | Off Days: " + $V{totalOffDays}
                    : ""
                )
                .append(
                    $V{totalPPM} != null && $V{totalPPM} > 0
                    ? "   | PPM: " + $V{totalPPM}
                    : ""
                )
                .append(
                    $V{totalAnnualLeaveDays} != null && $V{totalAnnualLeaveDays} > 0
                    ? "   | Annual Leave: " + $V{totalAnnualLeaveDays}
                    : ""
                )
                .append(
                    $V{totalDaysInYear} != null && $V{totalDaysInYear} > 0
                    ? "   | Total days in: " + $F{year_number} + " - " + $V{totalDaysInYear}
                    : ""
                )
                .toString()
        ]]></expression>
		</element>
	</lastPageFooter>
