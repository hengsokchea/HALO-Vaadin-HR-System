<jasperReport name="redundancy_sub_form" language="java" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="076e8e3b-4327-4851-aff9-07fe0ca756be">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hr"/>
	<parameter name="emp_performance_review_id" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT
  prr.performance_review_rating_id,
  prr.emp_performance_review_id,
  g.group_code, g.group_name_en, g.group_name_kh, g.group_desc_en, g.group_desc_kh,
  c.criteria_code, c.criteria_name_en, c.criteria_name_kh, c.criteria_desc_en, c.criteria_desc_kh,
  c.value_type, c.min_value, c.max_value, c.bool_true_score, c.bool_false_score,
  prr.rating_value, prr.bool_value, prr.text_value
FROM public.emp_performance_review_rating prr
left JOIN public.review_criteria c       ON c.criteria_id = prr.criteria_id
left JOIN public.review_criteria_group g ON g.group_id   = c.group_id
WHERE prr.emp_performance_review_id=$P{emp_performance_review_id}
ORDER BY g.sort_order, c.sort_order
]]></query>
