<!-- Created with Jaspersoft Studio version 7.0.2.final using JasperReports Library version 7.0.2-31532122640f516c6d17238ae0e41a08113d5ac0  -->
<jasperReport name="leave_request_form" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="880ba763-8ad5-4f35-ba90-c35732ff6fba">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="hr"/>
	<parameter name="emp_leave_id" class="java.util.Collection"/>
	<parameter name="SUBREPORT_DIR" forPrompting="false" class="java.lang.String"/>
	<parameter name="ATTACHMENT_DIR" forPrompting="false" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT
  emp_leave.emp_leave_id,
  emp_leave.emp_id,
  emp_master.insurance_no,
  emp_master.name_en,
  emp_master.name_kh,
  emp_master.gender,
  emp_leave.request_date,
  emp_leave.contact_number,
  request_department.department_name           AS department_en,
  request_department.department_name_kh        AS department_kh,
  request_position.emp_position                AS position_en,
  request_position.emp_position_kh             AS position_kh,
  emp_leave.reason,
  request_leave_status.leave_status_name       AS request_status_en,
  request_leave_status.leave_status_name_kh    AS request_status_kh,
  request_team.team_name                       AS team,
  request_team_type.list_team_type_name        AS team_type,

  line_manager_leave_status.leave_status_name    AS supervisor_status_en,
  line_manager_leave_status.leave_status_name_kh AS supervisor_status_kh,
  emp_leave.line_manager_check_date,
  line_manager.insurance_no                      AS supervisor_ins,
  line_manager.name_en                           AS supervisor_en,
  line_manager.name_kh                           AS supervisor_kh,
  line_manager_position.emp_position             AS supervisor_position_en,
  line_manager_position.emp_position_kh          AS supervisor_position_kh,
  emp_leave.line_manager_check_comments          AS supervisor_comments,

  hr_leave_status.leave_status_name              AS hr_status_en,
  hr_leave_status.leave_status_name_kh           AS hr_status_kh,
  emp_leave.hr_verification_date,
  hr_manager.insurance_no                        AS hr_ins,
  hr_manager.name_en                             AS hr_en,
  hr_manager.name_kh                             AS hr_kh,
  hr_position.emp_position                       AS hr_position_en,
  hr_position.emp_position_kh                    AS hr_position_kh,
  emp_leave.hr_verification_comments,

  sig.request_signature,
  sig.request_signature_byte,
  sig.supervisor_signature,
  sig.supervisor_signature_byte,
  sig.hr_signature,
  sig.hr_signature_byte

FROM public.emp_leave
JOIN public.emp_master
  ON emp_master.emp_id = emp_leave.emp_id
LEFT JOIN public.list_department  AS request_department
  ON request_department.department_id = emp_leave.department_id
LEFT JOIN public.list_position    AS request_position
  ON request_position.position_id = emp_leave.position_id
LEFT JOIN public.leave_status     AS request_leave_status
  ON request_leave_status.leave_status_id = emp_leave.leave_status_id
LEFT JOIN public.list_team        AS request_team
  ON request_team.team_id = emp_master.team_id
LEFT JOIN public.list_team_type   AS request_team_type
  ON request_team_type.list_team_type_id = request_team.team_type_id
LEFT JOIN public.emp_master       AS line_manager
  ON line_manager.emp_id = emp_leave.line_manager_check_by_emp_id
LEFT JOIN public.list_position    AS line_manager_position
  ON line_manager_position.position_id = emp_leave.line_manager_check_position_id
LEFT JOIN public.leave_status     AS line_manager_leave_status
  ON line_manager_leave_status.leave_status_id = emp_leave.line_manager_check_status_id
LEFT JOIN public.leave_status     AS hr_leave_status
  ON hr_leave_status.leave_status_id = emp_leave.hr_verification_status_id
LEFT JOIN public.emp_master       AS hr_manager
  ON hr_manager.emp_id = emp_leave.hr_verification_by_emp_id
LEFT JOIN public.list_position    AS hr_position
  ON hr_position.position_id = emp_leave.hr_verification_position_id

LEFT JOIN LATERAL (
  SELECT
    -- pick the latest (by attachment_id) name/bytes for each type
    (array_agg(a.file_name ORDER BY a.attachment_id DESC)
       FILTER (WHERE a.attachment_type_id = 1))[1] AS request_signature,
    (array_agg(a.file_data ORDER BY a.attachment_id DESC)
       FILTER (WHERE a.attachment_type_id = 1))[1] AS request_signature_byte,

    (array_agg(a.file_name ORDER BY a.attachment_id DESC)
       FILTER (WHERE a.attachment_type_id = 2))[1] AS supervisor_signature,
    (array_agg(a.file_data ORDER BY a.attachment_id DESC)
       FILTER (WHERE a.attachment_type_id = 2))[1] AS supervisor_signature_byte,

    (array_agg(a.file_name ORDER BY a.attachment_id DESC)
       FILTER (WHERE a.attachment_type_id = 3))[1] AS hr_signature,
    (array_agg(a.file_data ORDER BY a.attachment_id DESC)
       FILTER (WHERE a.attachment_type_id = 3))[1] AS hr_signature_byte
  FROM public.attachment a
  WHERE a.entity_table = 'emp_leave'
    AND a.entity_id = emp_leave.emp_leave_id
) AS sig ON TRUE
WHERE $X{IN, emp_leave.emp_leave_id, emp_leave_id}
]]></query>
