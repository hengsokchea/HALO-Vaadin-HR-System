	         && $F{supervisor_signature} != null 
	         && !$F{supervisor_signature}.trim().isEmpty())
	        ? new java.io.File($P{ATTACHMENT_DIR}, $F{supervisor_signature}.trim())
	        : null]]></expression>
	</variable>
