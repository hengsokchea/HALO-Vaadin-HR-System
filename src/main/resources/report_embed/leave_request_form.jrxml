	<variable name="reportedSignatureFile" class="java.io.File">
		<expression><![CDATA[($P{ATTACHMENT_DIR} != null 
	         && $F{request_signature} != null 
	         && !$F{request_signature}.trim().isEmpty())
	        ? new java.io.File($P{ATTACHMENT_DIR}, $F{request_signature}.trim())
	        : null]]></expression>
	</variable>
	<variable name="supervisorSignatureFile" class="java.io.File">
